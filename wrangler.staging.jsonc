// EdgePay-CF — STAGING environment config (self-contained).
//
// The Deploy to Cloudflare button only reads wrangler.jsonc (top level).
// This file exists for `npm run deploy:staging`. Replace the placeholder
// ids after creating the staging resources:
//   npx wrangler d1 create edgepay-cf-staging
//   npx wrangler kv namespace create KV --config wrangler.staging.jsonc
//   npx wrangler r2 bucket create edgepay-uploads-staging
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgepay-cf-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_NAME": "EdgePay",
    "APP_VERSION": "0.3.0",
    "APP_URL": "https://edgepay-cf-staging.your-subdomain.workers.dev",
    "APP_DOMAIN": "edgepay-cf-staging.your-subdomain.workers.dev",
    "LOG_LEVEL": "info",
    "DEFAULT_CURRENCY": "BDT",
    "DEFAULT_TIMEZONE": "Asia/Dhaka",
    "DEFAULT_LANGUAGE": "en",
    "JWT_ISSUER": "edgepay-cf",
    "JWT_TTL_SECONDS": "3600",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "WEBHOOK_MAX_RETRIES": "3",
    "WEBHOOK_BACKOFF_MS": "60000",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "RATE_LIMIT_MAX_REQUESTS": "120",
    "SESSION_TTL_SECONDS": "86400",
    "ENABLED_GATEWAYS": "bkash,nagad,rocket,bkash-api,nagad-merchant-api,sslcommerz,stripe,paypal,razorpay"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgepay-cf-staging",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000002" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "edgepay-uploads-staging" }
  ],
  "queues": {
    "producers": [
      { "queue": "webhook-out", "binding": "WEBHOOK_QUEUE" },
      { "queue": "email-out", "binding": "EMAIL_QUEUE" },
      { "queue": "sms-parse", "binding": "SMS_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "webhook-out",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "webhook-out-dlq"
      },
      {
        "queue": "email-out",
        "max_batch_size": 25,
        "max_batch_timeout": 30,
        "max_retries": 5
      },
      {
        "queue": "sms-parse",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *", "0 2 * * *"]
  },
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER_DO", "class_name": "LedgerDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LedgerDO"] }],
  "workflows": [
    {
      "name": "refund-reconciliation",
      "binding": "REFUND_WORKFLOW",
      "class_name": "RefundReconciliationWorkflow"
    },
    {
      "name": "reconciliation-sweep",
      "binding": "SWEEP_WORKFLOW",
      "class_name": "ReconciliationSweepWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT_READ",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_WRITE",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // "analytics_engine_datasets": [
  //   { "binding": "ANALYTICS", "dataset": "edgepay_metrics" }
  // ],
  "assets": {
    "directory": "./public/assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
