// EdgePay-CF — Worker configuration (Deploy-to-Cloudflare compatible).
//
// This is the SINGLE top-level environment the Deploy to Cloudflare button
// reads. Per the button contract, every binding carries a complete default
// (name, id, class, queue, …) so Cloudflare can provision fresh resources
// and rewrite the ids during deployment:
// https://developers.cloudflare.com/workers/platform/deploy-buttons/
//
// Separate self-contained configs live beside this file for non-production
// deployments (the button never reads them):
//   wrangler.dev.jsonc      -> npm run deploy:dev
//   wrangler.staging.jsonc  -> npm run deploy:staging
//
// v0.2.2 (audit P1): was 2024-10-22 (22 months stale). 2026-08-28 is the
// NEWEST compatibility date supported by BOTH runtimes this repo uses: the
// pinned test stack (miniflare 5.20260828.0-alpha / workerd 1.20260828.x
// via @cloudflare/vitest-plugin 1.1.2) and wrangler 4.127.1's bundled
// workerd (1.20260828.1). Bump this together with the devDependencies.
// (nodejs_compat_v2 behavior is default-on from 2026-08-04, so the explicit
// nodejs_compat flag below is forward-safe.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgepay-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,

  // ------------------------------------------------------------
  // Worker limits (Cloudflare)
  //   - CPU: 30s on Paid plan ($5/mo), 10ms on Free plan
  //   - Memory: 128MB
  //   - Subrequest limit: 50 (Free) / 1000 (Paid) per invocation
  //   - Script size: 10MB compressed
  // ------------------------------------------------------------

  // ============================================================
  // Environment variables (NON-SECRET)
  //   Secrets (JWT_SECRET, APP_KEY, ENCRYPTION_KEY, …) come from the
  //   Deploy to Cloudflare setup page (.dev.vars.example) or
  //   `wrangler secret put NAME` — never from this file.
  //
  //   ENABLED_GATEWAYS is intentionally UNSET here: the deploy button's
  //   setup page supplies it; when unset, every catalog gateway is
  //   enabled (back-compat). See src/gateways/enabled.ts + docs/GATEWAYS.md.
  // ============================================================
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "EdgePay",
    "APP_VERSION": "0.3.0",
    "APP_URL": "https://edgepay-cf.bm-jonybepary.workers.dev",
    "APP_DOMAIN": "edgepay-cf.bm-jonybepary.workers.dev",
    "LOG_LEVEL": "info",
    "DEFAULT_CURRENCY": "BDT",
    "DEFAULT_TIMEZONE": "Asia/Dhaka",
    "DEFAULT_LANGUAGE": "en",
    "JWT_ISSUER": "edgepay-cf",
    "JWT_TTL_SECONDS": "3600",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "WEBHOOK_MAX_RETRIES": "3",
    "WEBHOOK_BACKOFF_MS": "60000",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "RATE_LIMIT_MAX_REQUESTS": "120",
    "SESSION_TTL_SECONDS": "86400",
    // Gateway-plugin selection — default multi-gateway set
    "ENABLED_GATEWAYS": "bkash,nagad,rocket,bkash-api,nagad-merchant-api,sslcommerz,stripe,paypal,razorpay"
  },

  // ============================================================
  // D1 database — the Deploy button provisions a fresh database and
  // rewrites database_id; migrations run via the npm deploy script
  // (`wrangler d1 migrations apply DB --remote`).
  //   Free: 5GB storage, 5M rows read/day, 100K rows written/day
  //   Paid: 10GB storage, 25B rows read/day, 50M rows written/day
  // ============================================================
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgepay-cf",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // ============================================================
  // KV namespace — token caches, domain routing, rate-limit counters.
  //   Free: 100K reads/day, 1K writes/day, 1GB storage
  //   Paid: 10M reads/day, 1M writes/day, 1GB storage
  // ============================================================
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000"
    }
  ],

  // ============================================================
  // R2 bucket — receipt PDFs, brand assets.
  //   Free: 10GB storage, 1M Class A ops, 10M Class B ops/month, 0 egress
  // ============================================================
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "edgepay-uploads"
    }
  ],

  // ============================================================
  // Queues (free tier since Feb 2026) — provisioned by the deploy button
  //   - webhook-out: outbound webhook deliveries (with retry)
  //   - email-out:   outbound email queue
  //   - sms-parse:   SMS verification queue
  // ============================================================
  "queues": {
    "producers": [
      { "queue": "webhook-out", "binding": "WEBHOOK_QUEUE" },
      { "queue": "email-out", "binding": "EMAIL_QUEUE" },
      { "queue": "sms-parse", "binding": "SMS_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "webhook-out",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "webhook-out-dlq"
      },
      {
        "queue": "email-out",
        "max_batch_size": 25,
        "max_batch_timeout": 30,
        "max_retries": 5
      },
      {
        "queue": "sms-parse",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 3
      }
    ]
  },

  // ============================================================
  // Cron Triggers — 3 schedules (v0.2.1, consolidated from 5).
  //   Refund reconciliation is instance-per-refund workflow-driven;
  //   per-merchant scheduled work runs on LedgerDO alarms.
  //   The free plan allows only 5 crons PER ACCOUNT — 3 here leaves room.
  // ============================================================
  "triggers": {
    "crons": [
      "*/5 * * * *",      // Every 5 min: intent expiry, SMS verification
      "0 * * * *",        // Hourly: currency update, domain re-verify, posting replay
      "0 2 * * *"         // Daily 2am: reconciliation sweep workflow + update check
    ]
  },

  // ============================================================
  // Observability
  // ============================================================
  "observability": {
    "enabled": true,
    // v0.2.2 (audit P1): Workers Logs sampling lives under logs.
    "logs": { "head_sampling_rate": 1 },
    // v0.2.2 (audit P1): Workers Traces — sampled at 1%.
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  // ============================================================
  // Smart Placement (run Worker near DB instead of near client)
  // ============================================================
  "placement": { "mode": "smart" },

  // ============================================================
  // Durable Objects — ONE per-tenant LedgerDO per merchant.
  //   Owns the merchant's ENTIRE chart: a multi-account posting is a
  //   single atomic call (no per-account fan-out -> no atomicity gap).
  //   Free tier: 100K DO requests/day — comfortably covers ~5K tx/day.
  // ============================================================
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER_DO", "class_name": "LedgerDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LedgerDO"] }
  ],

  // ============================================================
  // Workers Workflows — durable multi-step orchestration
  //   - refund-reconciliation: instance-per-refund, bounded poll loop,
  //     halts as `errored` (= the DLQ, with alerting) after ~24h
  //   - reconciliation-sweep: daily pending replay + consistency verify
  //     + stuck refund re-drive
  // ============================================================
  "workflows": [
    {
      "name": "refund-reconciliation",
      "binding": "REFUND_WORKFLOW",
      "class_name": "RefundReconciliationWorkflow"
    },
    {
      "name": "reconciliation-sweep",
      "binding": "SWEEP_WORKFLOW",
      "class_name": "ReconciliationSweepWorkflow"
    }
  ],

  // ============================================================
  // Native Ratelimit bindings — PER-API-KEY limits (edge rules can only
  // express per-IP). Mounts: 120 reads/min, 30 writes/min per key.
  // Keep ONE free edge rule for volumetric per-IP abuse (dashboard).
  // ============================================================
  "ratelimits": [
    {
      "name": "RATE_LIMIT_READ",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_WRITE",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // ============================================================
  // Analytics Engine — per-merchant metrics without touching D1
  //   (opt-in after first deploy: enable at https://dash.cloudflare.com/
  //    under Workers & Pages > Analytics Engine, then uncomment here)
  // ============================================================
  // "analytics_engine_datasets": [
  //   { "binding": "ANALYTICS", "dataset": "edgepay_metrics" }
  // ],

  // ============================================================
  // Workers Static Assets — serves checkout CSS/JS with zero subrequests
  //   The Worker ALWAYS runs first — asset matching can never shadow
  //   API/webhook/checkout routes; the Worker delegates /assets/* to the
  //   ASSETS binding itself (see src/index.ts).
  // ============================================================
  "assets": {
    "directory": "./public/assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }

  // ============================================================
  // Workers AI — SMS parser long-tail fallback (opt-in after first
  //   deploy: uncomment and redeploy; the test runner cannot emulate it)
  // ------------------------------------------------------------
  // "ai": { "binding": "AI" }
  // ============================================================

  // ============================================================
  // Cloudflare Access — Zero Trust identity proxy for /admin/*
  //   Configured via Cloudflare dashboard (not this file):
  //   - Create an Access Application for https://<your-worker>/admin/*
  //   - Identity providers: Google, GitHub, Okta, SAML
  //   - MFA: enforced at the Access layer
  //   - The Worker sees CF-Access-Authenticated-Email on every request
  // ============================================================

  // ============================================================
  // Native Rate Limiting Rules (dashboard, not this file)
  //   Free zone: 1 rule. Pro zone ($25/mo): 10 rules. Recommended:
  //     - /api/v1/*        -> 120 req/min per IP
  //     - /api/v1/payments POST -> 30 req/min per IP
  //     - /api/admin/v1/*  -> 60 req/min per IP
  //     - /api/mobile/v1/* -> 60 req/min per IP
  //     - /install POST    -> 3 req/hour per IP
  //     - /api/v1/auth/login POST -> 5 req/5min per IP
  //   These run BEFORE the Worker — zero CPU cost, zero KV writes.
  // ============================================================

  // ============================================================
  // Cloudflare for SaaS Custom Hostnames (configured via API)
  //   - POST /zones/{zone}/custom_hostnames to provision per-brand hostnames
  //   - Automatic DV certificate issuance + renewal
  //   - See src/services/custom-hostnames.ts for the integration
  // ============================================================
}
