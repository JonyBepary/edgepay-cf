// EdgePay-CF — DEVELOPMENT environment config (self-contained).
//
// The Deploy to Cloudflare button only reads wrangler.jsonc (top level).
// This file exists for `npm run deploy:dev` (`wrangler deploy --config
// wrangler.dev.jsonc`) so a dev Worker never touches prod resources.
// Replace the placeholder ids after creating the dev resources:
//   npx wrangler d1 create edgepay-cf-dev
//   npx wrangler kv namespace create KV --config wrangler.dev.jsonc
//   npx wrangler r2 bucket create edgepay-uploads-dev
//   npx wrangler queues create webhook-out / webhook-out-dlq / email-out / sms-parse
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgepay-cf-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "ENVIRONMENT": "development",
    "APP_NAME": "EdgePay",
    "APP_VERSION": "0.3.0",
    "APP_URL": "http://localhost:8787",
    "APP_DOMAIN": "localhost",
    "LOG_LEVEL": "debug",
    "DEFAULT_CURRENCY": "BDT",
    "DEFAULT_TIMEZONE": "Asia/Dhaka",
    "DEFAULT_LANGUAGE": "en",
    "JWT_ISSUER": "edgepay-cf",
    "JWT_TTL_SECONDS": "3600",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "WEBHOOK_MAX_RETRIES": "3",
    "WEBHOOK_BACKOFF_MS": "60000",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "RATE_LIMIT_MAX_REQUESTS": "120",
    "SESSION_TTL_SECONDS": "86400",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD_TAG": "",
    "ALLOWED_ORIGINS": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgepay-cf-dev",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000001" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "edgepay-uploads-dev" }
  ],
  "queues": {
    "producers": [
      { "queue": "webhook-out", "binding": "WEBHOOK_QUEUE" },
      { "queue": "email-out", "binding": "EMAIL_QUEUE" },
      { "queue": "sms-parse", "binding": "SMS_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "webhook-out",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "webhook-out-dlq"
      },
      {
        "queue": "email-out",
        "max_batch_size": 25,
        "max_batch_timeout": 30,
        "max_retries": 5
      },
      {
        "queue": "sms-parse",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *", "0 2 * * *"]
  },
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER_DO", "class_name": "LedgerDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LedgerDO"] }],
  "workflows": [
    {
      "name": "refund-reconciliation",
      "binding": "REFUND_WORKFLOW",
      "class_name": "RefundReconciliationWorkflow"
    },
    {
      "name": "reconciliation-sweep",
      "binding": "SWEEP_WORKFLOW",
      "class_name": "ReconciliationSweepWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT_READ",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_WRITE",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "edgepay_metrics" }
  ],
  "assets": {
    "directory": "./public/assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
