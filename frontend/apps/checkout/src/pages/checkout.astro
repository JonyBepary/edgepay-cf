---
/**
 * EdgePay Customer-Facing Checkout Page (Astro Island Component)
 * Designed with Sanzo Wada Colorblind-Friendly Theme and GSAP Motion
 */
interface Props {
  merchantName?: string;
  amount?: string;
  currency?: string;
  intentToken?: string;
  orderId?: string;
}

const {
  merchantName = "",
  amount = "",
  currency = "BDT",
  intentToken = "",
  orderId = ""
} = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0F172A" />
  <title>{merchantName ? `Secure Checkout — ${merchantName}` : 'EdgePay Secure Checkout'}</title>
  <link rel="stylesheet" href="/styles/tokens.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"
          integrity="sha384-g4NTh/Iv5PPU4xPyhEWqPcwtNXOvdaDI8LLnyYfyNZOjKJeYQyjzQ9X5275eBjpt"
          crossorigin="anonymous" defer></script>
</head>
<body>
  <div id="checkout-island"
       data-token={intentToken}
       data-amount={amount}
       data-currency={currency}
       data-merchant={merchantName}
       data-order-id={orderId}>
    <!-- Static island shell hydrates with interactive GSAP & haptics from real live data -->
  </div>
  <script type="module" src="/scripts/checkout-island.js"></script>
</body>
</html>
