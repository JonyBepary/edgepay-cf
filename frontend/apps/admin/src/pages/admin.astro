---
/**
 * EdgePay Platform Admin Console (Astro Island Component)
 * Designed with Sanzo Wada Colorblind-Friendly Theme and GSAP Motion
 */
interface Props {
  platformTitle?: string;
  tenantCount?: number;
  apiOrigin?: string;
}

const {
  platformTitle = "EdgePay Platform Admin",
  tenantCount = 0,
  apiOrigin = ""
} = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{platformTitle}</title>
  <link rel="stylesheet" href="/styles/tokens.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"
          integrity="sha384-g4NTh/Iv5PPU4xPyhEWqPcwtNXOvdaDI8LLnyYfyNZOjKJeYQyjzQ9X5275eBjpt"
          crossorigin="anonymous" defer></script>
</head>
<body>
  <div id="admin-island" data-tenants={tenantCount} data-api-origin={apiOrigin}>
    <!-- Static platform console hydrates dynamically with provisioning modals & live D1 telemetry -->
  </div>
  <script type="module" src="/scripts/admin-island.js"></script>
</body>
</html>
